use rx::core::*;

use rx::core::{getInt, printlnInt, printInt as unused_print,};
struct View<'a> where 'a: 'a { value: &'a i32 }
impl<'a> View<'a> {
    fn new(value: &'a i32) -> Self { Self { value: value } }
    fn get(&self) -> &'a i32 { self.value }
}
fn shorten<'long: 'short, 'short>(value: &'long i32) -> &'short i32
where 'long: 'short, { value }
fn main() {
    let x = getInt(); let v: View<'_> = View::new(&x);
    printlnInt(*shorten(v.get()));
    let mut refs = Vec::<&i32>::new(); refs.push(&x); printlnInt(*refs[0]);
}
