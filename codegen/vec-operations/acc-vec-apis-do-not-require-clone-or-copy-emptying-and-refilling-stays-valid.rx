use rx::core::*;

struct Item { value: Box<i32> }
fn main() {
    let mut v = Vec::<Item>::new();
    v.push(Item { value: Box::<i32>::new(4) }); v.push(Item { value: Box::<i32>::new(7) });
    let taken = v.remove(0); printlnInt(*taken.value); printlnInt(*v[0].value);
    v[0] = Item { value: Box::<i32>::new(9) }; printlnInt(*v.remove(0).value);
    printlnInt(v.is_empty() as i32); v.push(taken); printlnInt(*v[0].value);
}
