use rx::core::*;

fn main() {
    let mut v = Vec::<usize>::new(); printlnInt(v.is_empty() as i32); let mut i = 0usize; while i < 100usize { v.push(v.len()); i += 1usize; } printlnInt(v.len() as i32); printlnInt(v.remove(0) as i32); printlnInt(v.remove(49) as i32); printlnInt(v.remove(97) as i32); v[0] = 123; printlnInt(v[0] as i32); printlnInt(v[49] as i32); printlnInt(Vec::<usize>::len(&v) as i32); Vec::<usize>::push(&mut v, 321); printlnInt(v[97] as i32);
}
