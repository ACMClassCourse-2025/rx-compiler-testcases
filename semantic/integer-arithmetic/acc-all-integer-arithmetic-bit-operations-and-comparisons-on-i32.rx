fn main() {
    let a = getInt() as i32; let b = getInt() as i32;
    printlnInt((a + b) as i32);
    printlnInt((a - b) as i32);
    printlnInt((a * b) as i32);
    printlnInt((a / b) as i32);
    printlnInt((a % b) as i32);
    printlnInt((a & b) as i32);
    printlnInt((a | b) as i32);
    printlnInt((a ^ b) as i32);
    printlnInt((!a) as i32);
    printlnInt((a < b) as i32);
    printlnInt((a <= b) as i32);
    printlnInt((a > b) as i32);
    printlnInt((a >= b) as i32);
    printlnInt((a == b) as i32);
    printlnInt((a != b) as i32);
    printlnInt((-a) as i32);
}
