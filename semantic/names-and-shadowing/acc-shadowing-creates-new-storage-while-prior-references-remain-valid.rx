fn main() {
    let n = 3; let r = &n; let n = n + 4;
    { let n = true; printlnInt(n as i32); }
    printlnInt(n); printlnInt(*r);
    let s = Same { x: Same() }; printlnInt(s.x);
    printlnInt(later(4));
}
struct Same { x: i32 }
fn Same() -> i32 { 8 }
fn later(mut x: i32) -> i32 { x += 1; let x = x * 2; x }
