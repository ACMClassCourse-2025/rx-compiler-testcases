#[derive(Clone, Copy)]
struct Counter { value: i32 }
impl Counter {
    const START: i32 = 3;
    fn new() -> Self { Self { value: Self::START } }
    fn value(&self) -> i32 { self.value }
    fn add(&mut self, x: i32) { self.value += x; }
}
impl Counter {
    fn owned(self) -> i32 { self.value }
    fn changed(mut self) -> Self { self.value += 10; self }
}
fn main() {
    let mut c = Counter::new(); c.add(4); printlnInt(c.value());
    let d = c.changed(); printlnInt(c.value); printlnInt(d.owned());
    Counter::add(&mut c, 2); printlnInt(Counter::value(&c));
    let mut b = Box::<Counter>::new(c); b.add(1); printlnInt(b.value());
    let r = &mut b; r.add(2); printlnInt(r.value());
    printlnInt(Counter::new().changed().value());
}
